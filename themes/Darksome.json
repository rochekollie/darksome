	"tokenColors": [
		{
			"name": "Global Text",
			"scope": [
				"text",
				"source",
				"meta"
			],
			"settings": {
				"foreground": "#9ebddd"
			}
		},
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#303c53",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": {
				"foreground": "#707dd5"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#b181d7"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"support.type"
			],
			"settings": {
				"foreground": "#a75274"
			}
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#2aabb8"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#1c989b"
			}
		},
		{
			"name": "Constants, Language Constants, Escapes",
			"scope": [
				"constant.language",
				"support.constant",
				"constant.character",
				"constant.escape"
			],
			"settings": {
				"foreground": "#2aabb8"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"variable.other"
			],
			"settings": {
				"foreground": "#9ebddd"
			}
		},
		{
			"name": "Operators and Punctuation",
			"scope": [
				"keyword.operator",
				"punctuation",
				"punctuation.separator",
				"punctuation.terminator",
				"punctuation.section"
			],
			"settings": {
				"foreground": "#80a4c1"
			}
		},
		{
			"name": "Markdown - Headings",
			"scope": [
				"markup.heading.markdown",
				"markup.heading.setext.1.markdown",
				"markup.heading.setext.2.markdown",
				"markup.heading.atx.1.markdown",
				"markup.heading.atx.2.markdown",
				"markup.heading.atx.3.markdown",
				"markup.heading.atx.4.markdown",
				"markup.heading.atx.5.markdown",
				"markup.heading.atx.6.markdown"
			],
			"settings": {
				"foreground": "#42a5f5",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown - Heading Punctuation",
			"scope": [
				"punctuation.definition.markdown",
				"markup.heading.markdown punctuation.definition.heading.markdown"
			],
			"settings": {
				"foreground": "#80a4c1"
			}
		},
		{
			"name": "Markdown - Text Bold",
			"scope": [
				"markup.bold.markdown"
			],
